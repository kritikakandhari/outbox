PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
JWT_SECRET=change-me

# Infra
REDIS_URL=redis://localhost:6379
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=scheduler
ELASTICSEARCH_URL=http://localhost:9200

# Google OAuth (redirect URI: http://localhost:4000/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack OAuth (redirect URL: http://localhost:4000/api/slack/callback, scope: incoming-webhook)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Scheduler tuning (nothing hardcoded)
SENDER_COUNT=3                 # number of Ethereal sender accounts
WORKER_CONCURRENCY=5           # parallel jobs per worker
MIN_DELAY_BETWEEN_EMAILS_MS=2000  # min gap between any two sends (BullMQ limiter)
MAX_EMAILS_PER_HOUR_PER_SENDER=200 # default hourly cap per sender
RUN_WORKER_IN_API=true         # set false and run `npm run worker` separately
